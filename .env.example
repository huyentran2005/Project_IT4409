# MinIO (development only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=task-files

# PostgreSQL (development only)
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db

# Local backend connects through the host-published port.
DATABASE_URL=postgresql+psycopg://task_user:task_password@localhost:5433/task_db
CELERY_BROKER_URL=redis://localhost:6381/0

# Google SSO OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/sso/google/callback
FRONTEND_URL=http://localhost:5173

# GitHub SSO OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/sso/github/callback

# JWT Security
JWT_SECRET_KEY=change-this-in-env-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP invitation email. Với Gmail, SMTP_PASSWORD phải là App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TaskFlow
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Document Q&A chatbot
LLM_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_native_bm25
DOCS_DIR=docs
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
OPENROUTER_RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
