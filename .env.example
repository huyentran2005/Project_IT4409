# MinIO (development only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=task-files

# PostgreSQL (development only)
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db

# Services inside Docker Compose communicate through service name `db`.
DATABASE_URL=postgresql+psycopg://task_user:task_password@db:5432/task_db

# Google SSO OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/sso/google/callback
FRONTEND_URL=http://localhost:5173

# GitHub SSO OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/sso/github/callback

# JWT Security
JWT_SECRET_KEY=change-this-in-env-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
