# MinIO (development only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=task-files

# PostgreSQL (development only)
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db

# Services inside Docker Compose communicate through service name `db`.
DATABASE_URL=postgresql+psycopg://task_user:task_password@db:5432/task_db
